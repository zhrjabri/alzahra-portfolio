# Copy this file to .env and fill in your real values.
# .env is git-ignored — never commit it.

# --- SMTP server (Gmail defaults) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# The Gmail account that SENDS the mail (this is the account the App Password
# belongs to). It can be different from the inbox that receives the messages.
SMTP_USER=zhrjabri47@gmail.com

# 16-character Gmail App Password (NOT your normal Gmail password).
# Paste it without spaces, e.g. abcdefghijklmnop
SMTP_PASSWORD=your_16_char_app_password

# --- Addresses ---
# Gmail requires From to match SMTP_USER; leave as-is unless you know otherwise.
MAIL_FROM=zhrjabri47@gmail.com
# Where contact-form messages are DELIVERED
MAIL_TO=aljabrialzahra1@gmail.com

# Seconds to wait on the SMTP connection
SMTP_TIMEOUT=20

# --- API server ---
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public URL of this backend; the frontend uses the same value as NEXT_PUBLIC_API_URL
API_BASE_URL=http://127.0.0.1:5000
