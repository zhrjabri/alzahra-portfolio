# Frontend env vars. Copy to .env.local for local dev; set the same keys in
# Vercel -> Settings -> Environment Variables for production.

# Public URL of this site. Used for canonical metadata, Open Graph share
# previews, robots.txt and sitemap.xml. Change it when a custom domain is live.
NEXT_PUBLIC_SITE_URL=https://alzahra-portfolio.vercel.app

# Public URL of the Flask contact-form backend (see render.yaml).
# Without this the form falls back to http://127.0.0.1:5000, which only works
# while the backend is running on your own machine.
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000
